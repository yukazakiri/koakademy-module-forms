{
    "name": "koakademy/forms",
    "description": "Configurable online forms, surveys, evaluations, and record-linked submissions for KoAkademy.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "KoAkademy contributors"
        }
    ],
    "require": {
        "php": ">=8.5 <8.6",
        "filament/filament": "^5.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-permission": "^6.21"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "laravel/pint": "^1.24",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Forms\\": "app/",
            "Modules\\Forms\\Database\\Factories\\": "database/factories/",
            "Modules\\Forms\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\Forms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Forms\\Providers\\FormsServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "scripts": {
        "test": "pest --compact"
    }
}
